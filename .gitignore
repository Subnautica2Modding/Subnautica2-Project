# Visual Studio 2015 user specific files
.vs/
.idea/

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.DotSettings.user
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

*.pdb
*.exe
!Automation/**/*.exe

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*
Windows/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Ignore all content except for mods and splash screen
Content/*
!Content/_EditorScripts/
!Content/DynamicClasses/
!Content/Mods/*
!Content/Splash/
!Content/Splash/EdSplash.png

# Ignore all plugin content except for those added in from the marketplace
Plugins/**/Content/*
!Plugins/FMODStudioNiagara/Content/*
!Plugins/NiagaraUIRenderer/Content/*

# Native FMOD DLLs are Firelight copyright. Copy from the official FMOD download via setup-fmod.ps1.
Plugins/FMODStudio/Binaries/Win64/fmod*.dll
Plugins/FMODStudio/Binaries/Win64/fmod*.lib
Plugins/FMODStudio/Binaries/Win64/resonanceaudio.dll
Plugins/FMODStudio/Binaries/Android/
Plugins/Developer/*

Automation/copy.bat